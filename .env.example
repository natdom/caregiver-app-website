# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.joinpero.com

# Analytics (Optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=www.joinpero.com

# Email delivery and waitlist storage (full-access key required; sending-only keys cannot manage contacts)
RESEND_API_KEY=re_your_resend_api_key_here
# Must use a domain verified in Resend, or sending will fail
RESEND_FROM=pero <hello@joinpero.com>
# Inbox that receives contact submissions and newsletter notifications
CONTACT_INBOX=hello@joinpero.com

# Newsletter Provider (Optional)
# Mailchimp
MAILCHIMP_API_KEY=your_mailchimp_api_key
MAILCHIMP_SERVER_PREFIX=us1
MAILCHIMP_AUDIENCE_ID=your_audience_id

# ConvertKit (alternative)
CONVERTKIT_API_KEY=your_convertkit_api_key
CONVERTKIT_FORM_ID=your_form_id

# Environment
NODE_ENV=development
